# Used when running WITHOUT Docker (docker compose sets its own database automatically)
DATABASE_URL=postgresql://payguard:payguard@localhost:5432/payguard

# ---------- PayPal Sandbox (leave blank = simulation mode with fake SIM- orders) ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ---------- AI (leave blank = rules engine only) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- accounts & security ----------
ALLOW_SELF_REGISTRATION=true
# true = verification/reset/invite tokens are returned in API responses so you can test without email.
# MUST be false in production.
EXPOSE_TOKENS_IN_RESPONSE=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---------- email (blank = emails are only logged) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PayGuard <no-reply@yourdomain.com>"

# ---------- ops ----------
CORS_ORIGINS=*
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=20
TRUST_PROXY=false
DB_POOL_MIN=2
DB_POOL_MAX=10

